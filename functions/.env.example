# Atlassian credentials
ATLASSIAN_URL=https://your-domain.atlassian.net
ATLASSIAN_USERNAME=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Copilot Studio agent integration (server-side only)
# Keep real values in functions/.env.local (never commit secrets)
COPILOT_STUDIO_AGENT_URL=https://your-agent-endpoint
COPILOT_STUDIO_API_KEY=your-agent-api-key
COPILOT_STUDIO_TIMEOUT_MS=10000
